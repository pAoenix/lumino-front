page {
  width: 100%;
  height: 100%;
}
.charts {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.charts .chart_box {
  flex: 1;
  overflow: auto;
  padding-bottom: 20px;
}
.charts .chart_box .total_warpper {
  display: flex;
  flex-direction: column;
  padding: 5px 10px;
}
.charts .chart_box .total_warpper .chart_total {
  font-size: 11px;
}
.charts .chart_box .total_warpper .chart_total text {
  color: #999;
}
.charts .charts_box {
  padding: 0 10px 10px;
  height: 200px;
}
.charts .Ranking {
  padding: 20px 10px;
}
.charts .Ranking .Ranking_title {
  font-weight: bold;
  font-size: 15px;
  height: 30px;
  line-height: 30px;
}
.charts .Ranking .Ranking_warpper .Ranking_fow {
  display: flex;
  align-items: center;
  position: relative;
  padding: 10px;
  gap: 20px;
  justify-content: space-between;
}
.charts .Ranking .Ranking_warpper .Ranking_fow .line_progress {
  width: calc(100% - 50px);
}
.charts .Ranking .Ranking_warpper .Ranking_fow .line_progress .data {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 5px;
}
.charts .Ranking .Ranking_warpper .Ranking_fow .line_progress .data .iconName {
  font-weight: bold;
  font-size: 13px;
}
.charts .Ranking .Ranking_warpper .Ranking_fow .line_progress .data .newPercent {
  font-size: 11px;
  color: #999;
}
.charts .Ranking .Ranking_warpper .Ranking_fow .line_progress .data .amount {
  margin-left: auto;
  font-size: 11px;
}
.charts .charts_warpper {
  width: 100%;
  height: 100%;
}
.charts .container_header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  padding: 10px 10px;
  box-sizing: border-box;
  box-shadow: 0 0 3px #eee;
  flex: 0;
}
.charts .container_header .account_book_user {
  position: absolute;
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
}
.charts .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item {
  justify-content: flex-start;
}
.charts .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row {
  display: flex;
  align-items: center;
}
.charts .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row .u-dropdown__menu__item__text {
  font-size: 16px !important;
  font-weight: bold;
}
.charts .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row .u-dropdown__menu__item__arrow .uni-text {
  font-size: 16px !important;
  font-weight: bold;
}
.charts .container_header .account_book .u-dropdown__content .u-cell__title-text {
  font-size: 16px !important;
  font-weight: 500;
}
.charts .container_header text {
  font-size: 22px;
  font-weight: bold;
}
.charts .custom-navbar {
  width: 100%;
  background-color: #55c9c9;
  flex: 0;
}
.charts .custom-navbar .nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
}
.charts .custom-navbar .nav-content .nav-title {
  color: #444;
  font-size: 17px;
  height: 100%;
  width: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.charts .custom-navbar .nav-content .navActive {
  position: relative;
  font-weight: bold;
}
.charts .custom-navbar .nav-content .navActive::after {
  position: absolute;
  content: "";
  display: block;
  width: 30px;
  height: 2px;
  background: #444;
  bottom: 1px;
  left: 50%;
  transform: translateX(-50%);
}