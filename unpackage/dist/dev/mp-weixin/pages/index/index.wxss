.container {
  padding-bottom: calc(60px + env(safe-area-inset-bottom));
}
.container .account_warpper {
  width: 100%;
  padding: 10px;
  box-sizing: border-box;
}
.container .account_warpper .container_header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  position: relative;
}
.container .account_warpper .container_header .account_book_user {
  position: absolute;
  top: 50%;
  right: 5px;
  transform: translateY(-50%);
}
.container .account_warpper .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item {
  justify-content: flex-start;
}
.container .account_warpper .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row {
  display: flex;
  align-items: center;
}
.container .account_warpper .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row .u-dropdown__menu__item__text {
  font-size: 20px !important;
  font-weight: bold;
}
.container .account_warpper .container_header .account_book .u-dropdown__menu .u-dropdown__menu__item .u-flex-row .u-dropdown__menu__item__arrow .uni-text {
  font-size: 20px !important;
  font-weight: bold;
}
.container .account_warpper .container_header .account_book .u-dropdown__content .u-cell__title-text {
  font-size: 16px !important;
  font-weight: 500;
}
.container .account_warpper .container_header text {
  font-size: 22px;
  font-weight: bold;
}
.container .account_warpper .swiper_warpper {
  height: 120px;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item {
  padding: 0 20px 20px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  justify-content: space-between;
  background: linear-gradient(45deg, #55c9c9, #24f4eb);
  border-radius: 10px;
  position: relative;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item .title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 30px;
  line-height: 30px;
  background-color: #00000047;
  color: #fff;
  font-size: 12px;
  text-align: center;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item text {
  display: block;
  color: #fff;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item .count {
  font-size: 30px;
  font-weight: bold;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item .counts {
  font-size: 20px;
}
.container .account_warpper .swiper_warpper .swiper_warpper_item .type,
.container .account_warpper .swiper_warpper .swiper_warpper_item .text {
  font-size: 13px;
}
.container .account_warpper .account_title {
  width: 100%;
  font-size: 11px;
  padding: 10px 10px 0px;
  border-top: 1px solid #f0f0f0;
  box-sizing: border-box;
  color: #aaa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
}
.container .account_warpper .account_title .title_total {
  display: flex;
  gap: 10px;
  font-size: 11px;
}
.container .account_warpper .account_title .title_total .title_span {
  font-size: 12px;
}
.container .account_warpper .account_title .title_total .title_text {
  font-weight: 400;
  font-size: 11px;
  color: #888;
}
.container .account_warpper .account_title_noborder {
  margin-top: 0;
  border-top: none;
}
.container .account_warpper .account_table {
  padding: 0 0 0 10px;
  display: flex;
  flex-direction: column;
}
.container .account_warpper .account_table .u-swipe-action-item {
  border-bottom: 1px solid #f5f5f5a1;
}
.container .account_warpper .account_table .noBorder {
  border-bottom: none;
}
.container .account_warpper .account_table .u-swipe-action-item__right {
  top: 1px;
  bottom: 1px;
  right: 1px;
}
.container .account_warpper .account_table .account_for {
  width: 100%;
  padding: 10px 10px 10px 0;
  box-sizing: border-box;
  display: flex;
  gap: 15px;
  align-items: center;
  position: relative;
}
.container .account_warpper .account_table .account_for .svg-icon {
  box-sizing: border-box;
  padding: 8px;
  border-radius: 50%;
  background: #eeeeee;
}
.container .account_warpper .account_table .account_for .for_img {
  width: 30px;
  height: 30px;
}
.container .account_warpper .account_table .account_for .for_warpper .userName {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  color: #aaa;
}
.container .account_warpper .account_table .account_for .for_warpper .userName .name {
  font-weight: bold;
  color: #666;
  margin-right: 3px;
}
.container .account_warpper .account_table .account_for .for_warpper .userName .name_type {
  color: #666;
  margin-right: 3px;
}
.container .account_warpper .account_table .account_for .for_warpper .userName .users {
  color: #666;
}
.container .account_warpper .account_table .account_for .for_warpper .userName .users .users_number {
  font-weight: bold;
}
.container .account_warpper .account_table .account_for .for_warpper .type {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #999;
}
.container .account_warpper .account_table .account_for .for_warpper .type text {
  display: block;
  font-size: 14px;
  color: #333;
}
.container .account_warpper .account_table .account_for .amount {
  font-size: 15px;
  color: #333;
  margin-left: auto;
  margin-bottom: 15px;
}
.container .account_warpper .account_table .account_for .income {
  color: #feb414;
}
.container .account_warpper .account_table .account_for .date {
  position: absolute;
  bottom: 10px;
  right: 10px;
  font-size: 10px;
  color: #666;
}
.bottom_icon {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 60px;
  z-index: 9999999999;
  border-top: 1px solid #f0f0f0;
  border-bottom: none;
  border-radius: 50%;
  background: #fff;
  padding: 10px;
}
.bottom_icon .icon_img {
  width: 100%;
  height: 100%;
}