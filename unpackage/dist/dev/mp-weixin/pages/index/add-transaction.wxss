.add_transation {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
}
page {
  width: 100%;
  height: 100%;
}
.custom-navbar {
  width: 100%;
  background-color: #55c9c9;
  flex: 0;
}
.custom-navbar .nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
}
.custom-navbar .nav-content .nav-title {
  color: #444;
  font-size: 17px;
  height: 100%;
  width: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.custom-navbar .nav-content .navActive {
  position: relative;
  font-weight: bold;
}
.custom-navbar .nav-content .navActive::after {
  position: absolute;
  content: "";
  display: block;
  width: 30px;
  height: 2px;
  background: #444;
  bottom: 1px;
  left: 50%;
  transform: translateX(-50%);
}
.page-body {
  flex: 1;
  overflow: auto;
}
.page-body .icon_warpper {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(50px, 1fr));
  grid-gap: 20px 30px;
  padding: 20px 40px 10px;
  justify-items: center;
  box-sizing: border-box;
}
.page-body .icon_warpper .icon_for {
  width: 40px;
  display: grid;
}
.page-body .icon_warpper .icon_for .svg-icon {
  background: #eee;
  padding: 10px;
  border-radius: 50%;
  box-sizing: border-box;
}
.page-body .icon_warpper .icon_for .icon_svg {
  border: 2px solid transparent;
}
.page-body .icon_warpper .icon_for .icon_text {
  display: block;
  width: 100%;
  margin-top: 5px;
  font-size: 12px;
  color: #333;
  text-align: center;
  height: 18px;
  line-height: 18px;
}
.page-body .icon_warpper .isActive .svg-icon {
  background: #55c9c9;
}
.page-body .icon_warpper .isActive .icon_svg {
  border: 2px solid #55c9c9;
}
.page-body .icon_warpper .isActive .icon_text {
  color: #55c9c9;
}
.page-body .invite-friends {
  padding: 15px 20px calc(20px + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}
.page-body .invite-friends .add_icon {
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 17px;
  background: #55c9c9;
  color: #fff;
}
.page_padding {
  padding-bottom: calc(320px + env(safe-area-inset-bottom)) !important;
}
.keyboard_warpper {
  padding: 0 0 calc(env(safe-area-inset-bottom));
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  box-shadow: 0 0 10px #aaa;
}
.keyboard_warpper .players {
  height: 40px;
  display: flex;
  align-items: center;
  padding: 0 10px;
  border-bottom: 1px solid #f0f0f0;
}
.keyboard_warpper .players .players_title {
  font-size: 13px;
}
.keyboard_warpper .players .players_users {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: 12px;
}
.keyboard_warpper .keyboard_number {
  font-size: 18px;
  color: #333;
  height: 40px;
  line-height: 40px;
  padding: 0 10px 0 45px;
  text-align: right;
  position: relative;
}
.keyboard_warpper .keyboard_number .close {
  position: absolute;
  top: 0;
  left: 10px;
  color: #999;
  font-size: 13px;
}
.keyboard_warpper .keyboard_number .close:active {
  color: #333;
}
.keyboard_warpper .description {
  padding: 0 10px 5px;
}
.keyboard_warpper .description .description_warpper {
  display: flex;
  align-items: center;
  padding: 0 0 0 10px;
  background: #f0f0f0;
  border-radius: 4px;
}
.keyboard_warpper .description .description_warpper .title {
  font-size: 13px;
}
.keyboard_warpper .description .description_warpper .description_input {
  font-size: 13px;
  background: transparent;
  padding: 3px 10px !important;
}
.keyboard_warpper .description .description_warpper .description_input .u-input__content .input-placeholder {
  font-size: 13px;
}
.keyboard_warpper .description .description_warpper .description_input .u-input__content .uni-input-input {
  font-size: 13px;
}
.keyboard_warpper .keyboard_button_warpper {
  display: flex;
  flex-wrap: wrap;
  box-shadow: 0px 3px 2px #eee;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button {
  width: 25%;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 2px #ddd;
  font-size: 13px;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .button {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .buttonCal {
  display: flex;
  align-items: center;
  justify-content: center;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .buttonCal .icon_but {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50%;
  height: 100%;
  box-shadow: 0 0 2px #ddd;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .done {
  background: #55c9c9;
  color: #fff;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .time {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button .time .text {
  font-size: 12px;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_button:active {
  background: #f0f0f0;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_nobutton:active {
  background: transparent !important;
}
.keyboard_warpper .keyboard_button_warpper .keyboard_nobutton .buttonCal .icon_but:active {
  background: #f0f0f0;
}