.account_book {
  padding: 20px;
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}
.account_book .account_book_warpper .sticky_text {
  width: 100%;
  height: 60px;
  line-height: 60px;
  font-size: 20px;
  box-shadow: 0 0 10px #f0f0f0;
  text-align: center;
  background: #fff !important;
}
.account_book .account_book_warpper .filter {
  display: flex;
  gap: 10px;
  margin-top: 20px;
  align-items: center;
  justify-content: space-between;
}
.account_book .account_book_warpper .filter .filter_warpper {
  display: flex;
  gap: 10px;
}
.account_book .account_book_warpper .filter .filter_warpper .u-tag {
  border-color: #55c9c9;
}
.account_book .account_book_warpper .filter .filter_warpper .u-tag .u-tag__text {
  color: #55c9c9;
}
.account_book .account_book_warpper .filter .filter_warpper .u-tag-active .u-tag--primary {
  background-color: #55c9c9;
  border-color: #55c9c9;
}
.account_book .account_book_warpper .filter .filter_warpper .u-tag-active .u-tag--primary .u-tag__text {
  color: #ffffff;
}
.account_book .account_book_warpper .filter .counts {
  display: flex;
}
.account_book .account_book_warpper .filter .counts .counts_img {
  width: 20px;
  height: 20px;
  margin-right: 5px;
}
.account_book .account_book_table {
  display: flex;
  gap: 10px;
  flex-direction: column;
  margin-top: 20px;
}
.account_book .account_book_table .table_for .table_title {
  text-align: right;
  color: #aaa;
  font-size: 13px;
  height: 30px;
  line-height: 30px;
}
.account_book .account_book_table .table_for .avatar_warpper {
  box-sizing: border-box;
  padding: 10px 20px;
}
.account_book .account_book_table .table_for .up-divider {
  margin: 5px 0 5px;
}
.account_book .account_book_table .table_for .table_warpper {
  box-shadow: 0 0 10px #f0f0f0;
}
.account_book .account_book_table .table_for .table_warpper .table_header {
  display: flex;
  height: 60px;
  box-sizing: border-box;
  padding: 0 20px;
  align-items: center;
  justify-content: space-between;
}
.account_book .account_book_table .table_for .table_warpper .table_header .text {
  font-size: 22px;
}
.account_book .account_book_table .table_for .table_warpper .table_foot {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
}
.account_book .account_book_table .table_for .table_warpper .table_foot .foot_but {
  display: flex;
  width: 50%;
  height: 30px;
  align-items: center;
  justify-content: center;
}
.account_book .account_book_table .table_for .table_warpper .table_foot .foot_but .but1,
.account_book .account_book_table .table_for .table_warpper .table_foot .foot_but .but2 {
  display: flex;
  font-size: 14px;
  align-items: center;
  gap: 5px;
  color: #333;
}
.account_book .account_book_table .table_for .table_warpper .table_foot .amount {
  padding: 0 20px;
  font-size: 14px;
  color: #333;
  height: 30px;
  line-height: 30px;
  padding-bottom: 10px;
  display: inline-flex;
  font-size: 12px;
}
.account_book .account_book_table .table_for .table_warpper .table_foot .amount .amount_text {
  font-size: 14px;
  font-weight: bold;
  color: #55c9c9;
  margin: 0 5px;
}