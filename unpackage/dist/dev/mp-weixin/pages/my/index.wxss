.my {
  padding-bottom: calc(60px + env(safe-area-inset-bottom));
}
.my .my_warpper {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
  padding: 30px 10px 30px 30px;
  box-sizing: border-box;
  background: #55c9c9;
}
page {
  background-color: #ededed;
}
.u-m-r-30 {
  margin-right: 30px;
}
.u-m-t-20 {
  margin-bottom: 20px;
}
.u-font-18 {
  font-size: 18px;
}
.u-font-14 {
  font-size: 14px;
}
.u-p-b-20 {
  padding-bottom: 20px;
  box-sizing: border-box;
}
.u-tips-color {
  color: #fff;
}
.u-m-l-a {
  margin-left: auto;
  display: flex;
}
.u-p-10 {
